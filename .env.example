# Invoice Keeper — настройки. Шаблон: cp .env.example .env
# Секретов в шаблоне нет: пароль суперадмина и токен бота задаются только в своём .env.
# Значения с $, # или пробелом берите в одинарные кавычки: ADMIN_PASSWORD='Pa$s #1'

# --- Веб-сервер ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# --- Единый часовой пояс для всех дат (IANA, например Europe/Moscow, Asia/Yekaterinburg) ---
APP_TIMEZONE=Europe/Moscow

# --- База данных (по умолчанию SQLite-файл ./data/invoice-keeper.db) ---
# DATABASE_URL=sqlite:///./data/invoice-keeper.db

# --- Суперадмин — единственный администратор. Задаётся только здесь; через панель и API не изменяется ---
# Логин: строчная латиница, цифры, . _ - (3–64 символа). Пароль: от 8 символов.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# --- Сессии ---
SESSION_TTL_HOURS=168
# true, если панель открывается по HTTPS
COOKIE_SECURE=false

# --- Telegram ---
# Токен от @BotFather. Без токена приложение работает, но напоминания не отправляются.
TELEGRAM_BOT_TOKEN=
# ID чата для напоминаний. Добавьте бота в чат, отправьте /chatid — бот ответит нужным числом.
TELEGRAM_CHAT_ID=
# Необязательно: прокси (http://user:pass@host:port или socks5://...) и свой адрес Bot API
TELEGRAM_PROXY=
TELEGRAM_API_URL=
# false — не принимать команды/кнопки (если этот же токен уже запущен в другом месте)
TELEGRAM_POLLING=true
# Публичный адрес панели — для кнопки «Открыть в панели» в сообщениях бота (только https://, не localhost)
# PUBLIC_URL=https://example.com

# --- Напоминания ---
# За сколько дней до срока напоминать по умолчанию (3–365). Администратор меняет это в панели
# («Настройки»), а у отдельного платежа можно задать своё.
REMINDER_DAYS_BEFORE=3
# Предельный размер файла чека, МБ (1–50). Загрузку можно отключить в панели («Настройки»).
# UPLOAD_MAX_MB=10
# Как часто проверять сроки, секунд
REMINDER_CHECK_INTERVAL_SECONDS=60

# --- Демо-данные: загружаются при первом запуске, если база пустая ---
SEED_DEMO_DATA=true
# Пароли демо-пользователей user и accountant (по умолчанию user12345 / accountant123).
# На сервере, доступном из интернета, обязательно задайте свои.
# DEMO_USER_PASSWORD=
# DEMO_ACCOUNTANT_PASSWORD=

# --- Только для сервера с HTTPS (docker-compose.prod.yml): домен для Caddy ---
# Без своего домена подойдёт <IP-сервера>.sslip.io, например 203.0.113.10.sslip.io
# DOMAIN=
