# managed-by: ansible
# Invoice Keeper {{ ik_version }} — файл генерируется Ansible (роль invoice_keeper).
# Ручные правки перезапишет следующий прогон: меняйте значения в inventory / group_vars / Vault.

# --- Суперадмин (единственный администратор) ---
ADMIN_LOGIN={{ ik_admin_login }}
ADMIN_PASSWORD='{{ ik_admin_password }}'

# --- Приложение ---
APP_TIMEZONE={{ ik_timezone }}
LOG_LEVEL={{ ik_log_level }}
SESSION_TTL_HOURS={{ ik_session_ttl_hours }}
COOKIE_SECURE={{ (ik_access_mode == 'https') | lower }}
PUBLIC_URL={{ ik_public_url }}

# --- Telegram ---
TELEGRAM_BOT_TOKEN='{{ ik_telegram_bot_token }}'
TELEGRAM_CHAT_ID={{ ik_telegram_chat_id }}
TELEGRAM_PROXY='{{ ik_telegram_proxy }}'
TELEGRAM_API_URL={{ ik_telegram_api_url }}
TELEGRAM_POLLING={{ ik_telegram_polling | bool | lower }}

# --- Напоминания ---
REMINDER_DAYS_BEFORE={{ ik_reminder_days_before }}
REMINDER_CHECK_INTERVAL_SECONDS={{ ik_reminder_check_interval_seconds }}

# --- Демо-данные (загружаются только в пустую базу) ---
SEED_DEMO_DATA={{ ik_seed_demo_data | bool | lower }}
{% if ik_seed_demo_data | bool %}
DEMO_USER_PASSWORD='{{ ik_demo_user_password }}'
DEMO_ACCOUNTANT_PASSWORD='{{ ik_demo_accountant_password }}'
{% endif %}

# --- Адрес и состав сервисов (читают Docker Compose и команда invoice-keeper) ---
DOMAIN={{ ik_domain if ik_access_mode == 'https' else '' }}
APP_PORT={{ ik_http_port }}
COMPOSE_FILE={{ ik_compose_files | join(':') }}
COMPOSE_PROJECT_NAME={{ ik_project }}
{% if ik_env_extra %}

# --- Дополнительно ---
{% for key, value in ik_env_extra | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
