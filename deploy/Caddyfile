# Caddy сам получает и продлевает сертификат Let's Encrypt для домена.
{$DOMAIN} {
	encode zstd gzip

	header {
		# браузер открывает сайт только по HTTPS (1 год)
		Strict-Transport-Security "max-age=31536000"
		# не раскрываем версию сервера
		-Server
	}

	reverse_proxy app:8080 {
		header_down -Server
	}
}

# Заход по голому IP (http://<IP>/) — перенаправляем на адрес с сертификатом.
:80 {
	redir https://{$DOMAIN}{uri} permanent
}
